{
    "manifest_version": 3,
    "name": "GooEbening",
    "version": "1.0.2",
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["Content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["images/*"],
            "matches": ["https://www.youtube.com/*"]
        }
    ]
}